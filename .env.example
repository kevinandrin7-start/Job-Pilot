# Copy this file to .env and fill in the values. .env is never committed.

# Anthropic API (required for resume parsing, job import, tailoring)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Effort for routine extraction vs. tailoring (low | medium | high | xhigh | max)
LLM_EFFORT_EXTRACT=low
LLM_EFFORT_TAILOR=high
# Server-side refusal fallbacks ("default" to enable, empty to disable)
LLM_FALLBACKS=default

# Adzuna (optional). Free key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# App
JOBPILOT_PORT=8000
JOBPILOT_DATA_DIR=data
# Optional: use an existing Chrome/Chromium instead of `playwright install chromium`
PLAYWRIGHT_CHROMIUM_PATH=
